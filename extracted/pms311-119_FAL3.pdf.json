    {
      "position_code": "FAL3",
      "task_number": 16,
      "category": "Perform Basic Faller Specific Duties",
      "behavior": null,
      "level": null,
      "verbatim_text": "Perform the required elements of a procedural sizeup, and any critical considerations that could affect each element. • Identify the objective of the cutting operation. • Identify the known hazards of the operation. • Recognize leans or binds that may be present. • Develop an escape plan. • Develop a cutting plan. • Determine complexity. • Make a Go/No-Go decision.",
      "code_raw": "O",
      "code_alternatives": [
        "O"
      ],
      "clarifications": [],
      "page": 7
    },
    {
