      "task_number": 17,
      "category": "Perform Basic Faller Specific Duties",
      "behavior": null,
      "level": null,
      "verbatim_text": "After performing a procedural sizeup, safely execute a cut plan to resolve a low complexity bucking operation using accepted practices.",
