# Regenerable / bulky — never commit
__pycache__/
.pytest_cache/

# Corpus PDFs/HTML (95 MB): re-download with `py src/ptb/acquire.py` and
# `py src/ptb/acquire_requirements.py`; corpus/manifest.json (committed)
# records url + sha256 for every file.
corpus/raw/

# Transient worklist produced when new candidate pairs need adjudication.
data/pending_adjudication.json

# COMMITTED on purpose (do not add here):
#   extracted/            - validated extraction JSONs (audit trail)
#   data/tier2_candidates.json - lets adjudicate.py run without the ML model
#   data/adjudications.json    - Claude's rubric verdicts (precious)
#   data/confirmations.json    - your human review decisions (precious)
#   reports/              - generated but useful to browse on GitHub
#   data/ptb.sqlite       - normally rebuilt (`py src/ptb/db.py`) and NOT
#     committed, but corpus/raw/ (the PDFs db.py needs for its provenance
#     check) is 95MB and gitignored, so a fresh clone/hosted deployment
#     (e.g. Streamlit Community Cloud) can't rebuild it - committing this
#     ~3MB snapshot lets app.py run read-only anywhere without the PDFs.
#     Still rebuild-and-recommit locally after any real corpus change.

# Local virtualenv
.venv/
